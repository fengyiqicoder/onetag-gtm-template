___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const queryPermission = require('queryPermission');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');

// GTM adds scripts asynchronously, so document.currentScript is null inside
// ask-docs.js and data-* attributes cannot be used. Options go in the URL instead.
const SCRIPT = 'https://onetagai.com/ask-docs.js';

const clean = (value) => {
  if (value === undefined || value === null) return '';
  return makeString(value).trim();
};

let color = clean(data.color);
if (color.charAt(0) === '#') color = color.substring(1);
let position = clean(data.position);
if (position === 'auto') position = '';

const options = [
  ['key', clean(data.siteKey)],
  ['ref', 'gtm'],
  ['label', clean(data.label)],
  ['position', position],
  ['color', color],
  ['lang', clean(data.lang)]
];

let url = SCRIPT;
let sep = '?';
for (let i = 0; i < options.length; i++) {
  if (options[i][1] !== '') {
    url = url + sep + options[i][0] + '=' + encodeUriComponent(options[i][1]);
    sep = '&';
  }
}

if (queryPermission('inject_script', url)) {
  // The cache token makes the script load once per page, even if the tag fires twice.
  injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'onetag-ask-docs');
} else {
  data.gtmOnFailure();
}


