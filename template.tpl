___TESTS___

scenarios:
- name: Loads the script with every option in the URL
  code: |-
    let injectedUrl;
    let injectedToken;
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      injectedUrl = url;
      injectedToken = cacheToken;
      onSuccess();
    });

    runCode({
      siteKey: 'ot_test123',
      label: 'Ask the docs',
      position: 'left',
      color: '0f766e',
      lang: 'zh-CN'
    });

    assertThat(injectedUrl).isEqualTo('https://onetagai.com/ask-docs.js?key=ot_test123&ref=gtm&label=Ask%20the%20docs&position=left&color=0f766e&lang=zh-CN');
    assertThat(injectedToken).isEqualTo('onetag-ask-docs');
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Leaves out empty options and the auto position
  code: |-
    let injectedUrl;
    mock('injectScript', function(url, onSuccess) {
      injectedUrl = url;
      onSuccess();
    });

    runCode({
      siteKey: 'ot_test123',
      label: '',
      position: 'auto',
      color: '',
      lang: ''
    });

    assertThat(injectedUrl).isEqualTo('https://onetagai.com/ask-docs.js?key=ot_test123&ref=gtm');
    assertApi('gtmOnSuccess').wasCalled();
- name: Encodes the label and drops the hash from the color
  code: |-
    let injectedUrl;
    mock('injectScript', function(url, onSuccess) {
      injectedUrl = url;
      onSuccess();
    });

    runCode({
      siteKey: 'ot_test123',
      label: 'Ask & learn?',
      position: 'float',
      color: '#ff6600',
      lang: 'en'
    });

    assertThat(injectedUrl).isEqualTo('https://onetagai.com/ask-docs.js?key=ot_test123&ref=gtm&label=Ask%20%26%20learn%3F&position=float&color=ff6600&lang=en');
- name: Calls gtmOnFailure when the script fails to load
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure) {
      onFailure();
    });

    runCode({
      siteKey: 'ot_test123',
      position: 'auto'
    });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: ''


